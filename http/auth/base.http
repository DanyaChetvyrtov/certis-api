POST {{ path }}/logout
Cookie: {{ authCookies }}

> {%
    client.test("Logout should be successful", function() {
        client.assert(response.status === 204, "Response status is not 204");
    });
%}

### POST test login before revoking all sessions
POST {{ path }}
Content-Type: application/json

{
  "email": "{{ email }}",
  "password": "{{ password }}"
}

> {%
    const authCookies = response.headers.valuesOf("Set-Cookie")
        .map(header => header.split(";")[0])
        .join("; ");

    client.test("Login before revoking all sessions should be successful", function() {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(authCookies.includes("access_token="), "Access token cookie is missing");
        client.assert(authCookies.includes("refresh_token="), "Refresh token cookie is missing");
    });

    client.global.set("authCookies", authCookies);
%}

### DELETE test all sessions
DELETE {{ path }}/sessions
Cookie: {{ authCookies }}

> {%
    client.test("All sessions revocation should be successful", function() {
        client.assert(response.status === 204, "Response status is not 204");
    });
%}
